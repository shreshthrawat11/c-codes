#include<stdio.h>
#include<string.h>

// User structure
struct User {
    char fullName[100];
    char username[100];
    char password[100];
};

typedef struct User U;

// Product structure
struct Product {
    char name[100];
    int stock;
};

typedef struct Product P;

// Function to create account
void createAccount() {
    U user, temp;
    FILE *fp;

    printf("Enter Full Name: \n");
    scanf(" %[^\n]", user.fullName);

    printf("Enter Username: \n");
    scanf("%s", user.username);

    printf("Enter Password: \n");
    scanf("%s", user.password);

    fp = fopen("users.dat", "rb");

    if (fp != NULL) {
        while (fread(&temp, sizeof(temp), 1, fp)) {
            if (strcmp(user.username, temp.username) == 0) {
                printf("Username already taken! Try again.\n");
                fclose(fp);
                return;
            }
        }
        fclose(fp);
    }

    fp = fopen("users.dat", "ab");

    if (fp == NULL) {
        printf("Error opening file.\n");
        return;
    }

    fwrite(&user, sizeof(user), 1, fp);
    fclose(fp);

    printf("Account created successfully!\n");
}

// Function to verify login
int authenticateUser() {
    U user;
    char uname[100], pass[100];
    FILE *fp;

    fp = fopen("users.dat", "rb");

    if (fp == NULL) {
        printf("No registered users found.\n");
        return 0;
    }

    printf("Enter Username: \n");
    scanf("%s", uname);

    printf("Enter Password: \n");
    scanf("%s", pass);

    while (fread(&user, sizeof(user), 1, fp)) {
        if (strcmp(uname, user.username) == 0 && strcmp(pass, user.password) == 0) {
            printf("Login successful!\n");
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

// Function to display products
void showInventory() {
    P items[4] = {
        {"iPhone", 50},
        {"iPad", 200},
        {"MacBook Air", 500},
        {"iMac", 468}
    };

    printf("\nAvailable Inventory:\n");

    for (int i = 0; i < 4; i++) {
        printf("Product: %s | Stock: %d\n", items[i].name, items[i].stock);
    }
}

// Menu display
void showMenu() {
    printf("\n1. Create Account\n");
    printf("2. Login\n");
    printf("Enter choice: ");
}

// Main function
int main() {
    int choice;

    showMenu();
    scanf("%d", &choice);

    switch (choice) {
        case 1:
            createAccount();
            break;

        case 2:
            if (authenticateUser()) {
                showInventory();
            } else {
                printf("Wrong username or password!\n");
            }
            break;

        default:
            printf("Invalid option selected!\n");
    }

    return 0;
}