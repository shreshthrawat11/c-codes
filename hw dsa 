struct Node* insertAtEnd(struct Node *head, int data)
{
    struct Node *newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = data;
    newNode->next = NULL;

    if(head == NULL)
        return newNode;

    struct Node *p = head;

    while(p->next != NULL)
        p = p->next;

    p->next = newNode;

    return head;
}