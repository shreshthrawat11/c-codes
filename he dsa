#include<stdio.h>
#include<stdlib.h>

// Structure
struct Node {
    int data;
    struct Node *next;
};

typedef struct Node Node;

Node *head = NULL;

// Insert at end
void insertEnd() {
    Node *newNode = (Node *)malloc(sizeof(Node));

    if(newNode == NULL) {
        printf("Memory allocation failed\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &newNode->data);
    newNode->next = NULL;

    if(head == NULL) {
        head = newNode;
    } else {
        Node *temp = head;
        while(temp->next != NULL)
            temp = temp->next;

        temp->next = newNode;
    }
}

// Display list
void showList() {
    Node *temp = head;

    if(temp == NULL) {
        printf("List is empty\n");
        return;
    }

    while(temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

// Count nodes
int countNodes() {
    int count = 0;
    Node *temp = head;

    while(temp != NULL) {
        count++;
        temp = temp->next;
    }
    return count;
}

// Insert at beginning
void insertBeginning() {
    Node *newNode = (Node *)malloc(sizeof(Node));

    if(newNode == NULL) {
        printf("Memory allocation failed\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &newNode->data);

    newNode->next = head;
    head = newNode;
}

// Insert at position
void insertAtPosition() {
    int pos, i = 1;

    Node *newNode = (Node *)malloc(sizeof(Node));

    if(newNode == NULL) {
        printf("Memory allocation failed\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &newNode->data);

    printf("Enter position: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > countNodes() + 1) {
        printf("Invalid position\n");
        return;
    }

    if(pos == 1) {
        newNode->next = head;
        head = newNode;
    } else {
        Node *temp = head;

        while(i < pos - 1) {
            temp = temp->next;
            i++;
        }

        newNode->next = temp->next;
        temp->next = newNode;
    }
}

// Delete node
void deleteAtPosition() {
    int pos, i = 1;

    if(head == NULL) {
        printf("List is empty\n");
        return;
    }

    printf("Enter position to delete: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > countNodes()) {
        printf("Invalid position\n");
        return;
    }

    if(pos == 1) {
        Node *temp = head;
        head = head->next;
        free(temp);
    } else {
        Node *temp = head;

        while(i < pos - 1) {
            temp = temp->next;
            i++;
        }

        Node *del = temp->next;
        temp->next = del->next;
        free(del);
    }
}

// Find middle element (better logic)
void findMiddle() {
    if(head == NULL) {
        printf("List is empty\n");
        return;
    }

    Node *slow = head;
    Node *fast = head;

    while(fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;
    }

    printf("Middle element = %d\n", slow->data);
}

// Main menu
int main() {
    int choice;

    printf("===== LINKED LIST MENU =====\n");

    while(1) {
        printf("\n1. Insert at End\n");
        printf("2. Display List\n");
        printf("3. Count Nodes\n");
        printf("4. Insert at Beginning\n");
        printf("5. Insert at Position\n");
        printf("6. Delete Node\n");
        printf("7. Find Middle Element\n");
        printf("8. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1: insertEnd(); break;
            case 2: showList(); break;
            case 3: printf("Total Nodes = %d\n", countNodes()); break;
            case 4: insertBeginning(); break;
            case 5: insertAtPosition(); break;
            case 6: deleteAtPosition(); break;
            case 7: findMiddle(); break;
            case 8: exit(0);
            default: printf("Invalid choice!\n");
        }
    }
}